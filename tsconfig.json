{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "types": ["node", "mocha"]
  },
  "include": ["index.js", "prod.js", "server/**/*", "types/**/*"],
  "exclude": ["server/libs", "node_modules", "client", "test"]
}
